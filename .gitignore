# Personal files: any file or folder whose name starts with "_" is never committed
_*
# Third-party code is kept exactly as published, even files starting with "_"
!third_party/**/_*

# Personal folder: notes, drafts, context for AI assistants
docs/personal/*
!docs/personal/README.md

